# .security/config.env - the ONLY file most teams ever edit.   Lines starting with # are comments.
# See what is switched on and why at any time:   .security/warden config show
# Precedence: command-line flags > environment variables > this file > preset > built-in defaults.

# ==== 1. PRESET: pick how strict to be ===========================================================
#   starter  = report-only. Scans run and produce a report, nothing can fail your build.   (start here, 2-4 weeks)
#   standard = blocks pull requests that add new Critical/High findings.
#   strict   = standard + the stricter "release" gate + SonarQube and Dependency-Check when they are configured.
SEC_PRESET=starter

# Override one piece of the preset only if you need to:
# SEC_ENFORCE=1        # 1 = fail the build on policy violations, 0 = report only
# SEC_GATE=pr          # pr (normal builds) or release (before deployment)

# ==== 2. TOOLS: auto | on | off ==================================================================
#   auto = run it when it fits your project (default).   on = always run.   off = never run.
# REQUIRED tools cannot be turned off here: gitleaks, semgrep, trivy (and agent-scan for AI agent repos,
# modelscan when model files exist). To waive one, add a time-boxed entry to .security/exceptions.json:
#   {"tool": "semgrep", "reason": "...", "approved_by": "name", "expires": "2026-12-31"}
# SEC_BANDIT=auto          # Python code security
# SEC_PIP_AUDIT=auto       # Python dependency CVEs
# SEC_NPM_AUDIT=auto       # Node dependency CVEs
# SEC_ESLINT=auto          # JavaScript / TypeScript security rules
# SEC_TRIVY_IMAGE=auto     # Docker image scan: runs when SEC_IMAGE is set
# SEC_SONAR=off            # SonarQube: needs the server URL (below) + SONAR_TOKEN as a CI secret (never in this file)
# SEC_DEPCHECK=off         # OWASP Dependency-Check (mainly Java): needs NVD_API_KEY or a prepared database
# SEC_ZAP=auto             # OWASP ZAP: runs when SEC_ZAP_URL is set
# SEC_REDTEAM=auto         # AI red-team probes: runs when SEC_REDTEAM_URL is set
# --- secrets in git HISTORY (optional; off on starter and standard, on for strict) -------------------------------------------------------
# A secret deleted in a later commit is still in the history. To scan the past commits too:
#   SEC_GITLEAKS_HISTORY=on        # turn it on
#   SEC_HISTORY_COMMITS=500        # how many of the newest commits to scan (default 3000). Smaller = faster
#   SEC_HISTORY_FETCH=auto         # shallow CI checkouts: fetch just that many commits (auto = when the workflow supplies WARDEN_GIT_TOKEN) | on | off
# SEC_GITLEAKS_HISTORY=off
# SEC_SBOM=auto            # software bill of materials (CycloneDX file next to the report)
# SEC_WORKFLOW_SCAN=auto   # GitHub Actions security: unpinned actions, script injection, excessive permissions
# SEC_K8S_POSTURE=auto     # Kubernetes manifest posture (kubescape, NSA framework)
# SEC_REPO_POSTURE=auto    # GitHub repository settings (branch protection, secret scanning ...): needs the CI secret GITHUB_TOKEN
# SEC_API_FUZZ=auto        # API fuzzing from an OpenAPI spec: runs when SEC_API_SPEC is set
# SEC_EXPOSURE=auto        # TLS / headers / sensitive paths / open ports: runs when SEC_EXPOSURE_TARGETS is set

# Which stacks to scan: auto (detects python / node / java / agent from your files) or a list, e.g. python,node
SEC_PROFILE=auto

# ==== 3. TARGETS (optional; the matching tool starts running once these are set) =================
# SEC_IMAGE=myapp:ci                          # the Docker image your pipeline builds
# SEC_ZAP_URL=https://my-app-qa.example.com   # a RUNNING QA/UAT app you own (never production)
# SEC_REDTEAM_URL=https://my-agent-qa.example.com   # AI agents: a RUNNING QA agent you own. Tokens as CI secrets:
#                                             # REDTEAM_TOKEN (test user), REDTEAM_TOKEN_B (second test user). Contract: .security/redteam.json
# SEC_REDTEAM_NETWORK=my_docker_network       # only when the agent runs in a local docker network
# SEC_API_SPEC=https://my-app-qa.example.com/openapi.json   # QA/UAT only. Optional CI secret API_TEST_TOKEN = bearer token the fuzzer sends
# SEC_API_NETWORK=my_docker_network           # only when the app runs in a local docker network
# SEC_EXPOSURE_TARGETS=https://my-app-qa.example.com   # systems you own, comma separated (reports what is reachable from where the scan runs)
# ZAP_AUTH_TOKEN (CI secret) makes the ZAP scan send "Authorization: Bearer <token>" on every request; ZAP_AUTH_HEADER="Name: value" for other schemes
# SEC_SONAR_KEY=warden-my-project
# SEC_SONAR_HOST_URL=https://sonar.example.com   # normally set once for everyone in configs/central.env; set here only to override
# SEC_DASHBOARD_URL=https://warden.example.com  # central dashboard; CI publishes each scan when the CI secret WARDEN_DASHBOARD_TOKEN exists
# --- Integrations (docs/integrations/). URLs are not secret; the tokens are CI secrets, never in this file ---
# SEC_DEFECTDOJO_URL=https://defectdojo.example.com   # findings register; CI secret DEFECTDOJO_TOKEN. One engagement per branch, reimported on every run
# SEC_DEFECTDOJO_PRODUCT=my-service                   # default: the repository name (owner/name). No spaces here
# SEC_DEFECTDOJO_BRANCHES=main,master                 # which branches publish (default main,master; * = all). Pull requests are skipped
# SEC_DTRACK_URL=https://dtrack-api.example.com       # Dependency-Track API server; CI secret DTRACK_API_KEY. Uploads the SBOM, then watches it for new CVEs
# SEC_DTRACK_PROJECT=my-service                       # default: the repository name; the project version is the branch
# SEC_DTRACK_BRANCHES=main,master                     # default main,master; * = all
# Wiz (needs a licence; docs/integrations/wiz.md): CI secrets WIZ_CLIENT_ID + WIZ_CLIENT_SECRET, then copy .security/ci/security-wiz.github.yml (or the Azure one)
# SEC_WIZ_SCANS=dir,iac                               # add image (and SEC_IMAGE=name:tag) to scan a built image
# SEC_WIZ_ENFORCE=1                                   # block the build when a Wiz policy fails (default: report-only)
# SEC_DEPCHECK_NOUPDATE=1                     # use the database prepared by the platform team
# --- DAST login: scan what is BEHIND the login (QA/UAT only). Non-secret settings here; usernames/passwords/tokens are CI secrets or `warden creds set`, NEVER in this file ---
# SEC_ZAP_AUTH=login-json        # basic | cookie | login-json | form | oauth2-client | oauth2-password   (SSO: oauth2-*; see docs/zap-authentication.md)
# SEC_ZAP_LOGIN_URL=https://qa.example.com/api/login     # login endpoint (or the identity provider's token endpoint for oauth2-*)
# SEC_ZAP_TOKEN_PATH=access_token                        # login-json: where the token is in the reply (data.token for nested)
# SEC_CREDENTIALS_PROFILE=qa     # which local credentials file `warden creds` uses on your machine
# SEC_SEMGREP_PACKS=auto                      # extra Semgrep SAST packs: auto (security-audit, CWE Top 25, injection, JWT, framework packs) | none | p/a,p/b
# SEC_SEMGREP_RULES=/path/to/rules            # offline/approved Semgrep rules instead of downloading from semgrep.dev

# ==== 4. SCOPE ===================================================================================
# Leave generated or vendored code out of the result (code and secret findings only: dependency CVEs are never excluded).
# SEC_EXCLUDE_PATHS=vendor/**,legacy/**,src/generated/**

# Cannot change here (central policy): severity thresholds, the required-tool list, scanner versions, the approved-model registry.
