# configs/central.env - organisation-wide defaults, set ONCE by the platform team (then released with the kit).
# Same KEY=value format as .security/config.env. A repo's own config.env and environment variables win over this file.
# Only non-secret values belong here. Secrets (SONAR_TOKEN, WARDEN_DASHBOARD_TOKEN) are CI secrets, never files.
#
# SonarQube server (needed for SEC_SONAR=on; the token is the CI secret SONAR_TOKEN):
# SEC_SONAR_HOST_URL=https://sonar.example.com:9000
#
# Central dashboard (CI publishes every scan to it; the token is the CI secret WARDEN_DASHBOARD_TOKEN):
# SEC_DASHBOARD_URL=https://warden.example.com:8090
